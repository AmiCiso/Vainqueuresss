# Copy to .env (never commit .env). All values below are PLACEHOLDERS.
# The server reads .env via Node's built-in process.loadEnvFile(); real environment variables take precedence.

NODE_ENV=development
PORT=3000
# HOST=127.0.0.1                  # dev default; production default is 0.0.0.0

# --- Provider credentials (server-side only; never sent to the browser) ---
# Google Safe Browsing Lookup API v4 key (non-commercial use only; see README "Providers").
GOOGLE_SAFE_BROWSING_KEY=
# abuse.ch Auth-Key for URLhaus (free key from https://auth.abuse.ch/).
URLHAUS_AUTH_KEY=

# --- Browser access (CORS is NOT authentication) ---
# Comma-separated exact origins allowed to call /api from a browser. Same-host origins are always allowed.
# Development default when unset: http://localhost|127.0.0.1 on ports 3000, 5500, 5501.
# Production default when unset: none (same-origin only).
# ALLOWED_ORIGINS=https://vainqueures.example
# PUBLIC_ORIGIN=https://vainqueures.example      # convenience: added to ALLOWED_ORIGINS
# CSP_CONNECT_EXTRA=https://api.vainqueures.example   # only if the page calls an API on another origin

# --- Reverse proxy / HTTPS ---
# Hop count of trusted proxies in front of the app (e.g. 1 for one load balancer), or a comma list of
# proxy IPs/CIDRs. Leave unset when the app is exposed directly. "true" is refused on purpose.
# TRUST_PROXY=1
# Set to "on" ONLY when HTTPS is guaranteed for every request (directly or via a TLS-terminating proxy
# that sets X-Forwarded-Proto and TRUST_PROXY is configured). Enables HSTS + upgrade-insecure-requests.
# HSTS=on

# --- Rate limiting and provider protection ---
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_STORE=memory         # "memory" (single instance / dev) or "redis" (multiple instances)
# REDIS_URL=redis://localhost:6379
# PROVIDER_TIMEOUT_MS=5000
# PROVIDER_MAX_CONCURRENT=8
# PROVIDER_MAX_QUEUE=32
# GSB_BUDGET_PER_MINUTE=120       # PER INSTANCE: divide your real quota by the number of instances
# URLHAUS_BUDGET_PER_MINUTE=60

# --- Cache ---
# CACHE_MAX_ENTRIES=1000
# CACHE_NO_MATCH_TTL_SEC=60       # local policy: the Lookup API gives no cache hint for "no match"
# CACHE_MATCH_TTL_SEC=300         # used when a match carries no cacheDuration
